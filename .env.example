# -----------------------------------------------------------------------------
# Portfolio Environment Baseline (.env.example)
# Copy to .env.local for local development. Never commit real secrets to Git.
# -----------------------------------------------------------------------------

# Neon PostgreSQL connection string.
# Never expose this value to client-side code.
# Real value belongs in local/deployment secrets, never Git.
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"

# Canonical URL of the website
SITE_URL="http://localhost:3000"
